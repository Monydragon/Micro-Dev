<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Product>Micro Dev</Product>
    <Company>Micro Dev</Company>
    <Authors>Micro Dev</Authors>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KniVersion>4.2.9001</KniVersion>
    <KniDesktopPlatformVersion>4.2.9001.1</KniDesktopPlatformVersion>
    <KniBlazorPlatformVersion>4.2.9001.2</KniBlazorPlatformVersion>
    <KniMobilePlatformVersion>4.2.9001</KniMobilePlatformVersion>
    <BlazorWebAssemblyVersion>10.0.4</BlazorWebAssemblyVersion>
    <MicroDevAndroidApplicationId>com.microdev.game</MicroDevAndroidApplicationId>
    <MicroDevAndroidVersionCode>100</MicroDevAndroidVersionCode>
    <MicroDevIosBundleId>com.microdev.ios</MicroDevIosBundleId>
    <MicroDevIosBuildNumber>100</MicroDevIosBuildNumber>
  </PropertyGroup>
</Project>
